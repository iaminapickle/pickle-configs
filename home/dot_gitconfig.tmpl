{{- /* Clipboard command for the `clh` aliases. Wayland on the CachyOS box,
       clip.exe under WSL (by full path: PATH interop can be turned off),
       and clip on native Windows. */ -}}
{{- $clip := "wl-copy" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $clip = "clip" -}}
{{- else if contains "microsoft" (lower (default "" .chezmoi.kernel.osrelease)) -}}
{{-   $clip = "/mnt/c/Windows/System32/clip.exe" -}}
{{- end -}}
[core]
	pager = delta
	editor = nvim
	; personal key by default; work repos override this via the includeIf below
	sshCommand = ssh -i ~/.ssh/personal -o IdentitiesOnly=yes
[user]
	email = {{ .email }}
	name = {{ .name }}
[alias]
	clh = "!git rev-parse HEAD | {{ $clip }}"
	clh2 = "!git rev-parse HEAD~1 | {{ $clip }}"
	clh3 = "!git rev-parse HEAD~2 | {{ $clip }}"
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	side-by-side = true
	line-numbers = true
	context = 3
[merge]
	conflictStyle = zdiff3
[rebase]
	autosquash = true
	autoStash = true
	updateRefs = true
[pager]
	branch = false
	blame = delta
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[diff]
	algorithm = histogram
[fetch]
	prune = true
	pruneTags = true
	all = true
[pull]
	rebase = true
[init]
	defaultBranch = main

{{ if .workEmail -}}
; --- work identity ---------------------------------------------------------
; Everything under ~/{{ .workDir }}/ commits as work and uses the work SSH
; key. Anything anywhere else gets the personal identity above.
[includeIf "gitdir:~/{{ .workDir }}/"]
	path = ~/.config/git/work.inc
{{ end -}}
