{{- /* Clipboard command for the `clh` aliases. Wayland on the CachyOS box,
       clip.exe under WSL (by full path: PATH interop can be turned off),
       and clip on native Windows. */ -}}
{{- $clip := "wl-copy" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $clip = "clip" -}}
{{- else if contains "microsoft" (lower (default "" .chezmoi.kernel.osrelease)) -}}
{{-   $clip = "/mnt/c/Windows/System32/clip.exe" -}}
{{- end -}}
[core]
	pager = delta
	editor = nvim
	; personal key by default; work repos override this via the includeIf below
	sshCommand = ssh -i ~/.ssh/personal -o IdentitiesOnly=yes
	excludesfile = ~/.gitignore_global
[user]
	email = {{ .email }}
	name = {{ .name }}
[alias]
	; tr strips rev-parse's trailing newline, which would break pasting.
	clh = "!git rev-parse HEAD | tr -d '\\n' | {{ $clip }}"
	clh2 = "!git rev-parse HEAD~1 | tr -d '\\n' | {{ $clip }}"
	clh3 = "!git rev-parse HEAD~2 | tr -d '\\n' | {{ $clip }}"
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	side-by-side = true
	line-numbers = true
	context = 3
[merge]
	conflictStyle = zdiff3
[rebase]
	autosquash = true
	autoStash = true
	updateRefs = false
[pager]
	branch = false
	blame = delta
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[diff]
	algorithm = histogram
[fetch]
	prune = true
	all = true
[pull]
	rebase = true
[init]
	defaultBranch = main
[sendemail]
	; send patches as the Workspace account, independent of user.email above
	from = samuele.yang@morsemicro.com
	smtpserver = smtp.gmail.com
	smtpuser = samuele.yang@morsemicro.com
	smtpencryption = tls
	smtpserverport = 587
; App password lives age-encrypted at ~/.config/git/smtp-credentials.
; Scoped to Gmail SMTP so no other credentials ever hit disk. The :587
; must match send-email's host:port, or the helper isn't consulted.
[credential "smtp://smtp.gmail.com:587"]
	helper = store --file ~/.config/git/smtp-credentials

{{ if .workEmail -}}
; --- work identity ---------------------------------------------------------
; Everything under ~/{{ .workDir }}/ commits as work; everywhere else is personal.
[includeIf "gitdir:~/{{ .workDir }}/"]
	path = ~/.config/git/work.inc
{{ end -}}
