# Ping-sweep a subnet to find alive hosts
# Usage: pingsweep 192.168.12   (sweeps 192.168.12.0/24)
#        pingsweep 192.168       (sweeps 192.168.0.0/16)
pingsweep() {
  local prefix="$1"
  if [[ -z "$prefix" ]]; then
    echo "Usage: pingsweep <prefix>"
    echo "  3-octet: pingsweep 192.168.12  → sweeps 192.168.12.0/24"
    echo "  2-octet: pingsweep 192.168     → sweeps 192.168.0.0/16"
    return 1
  fi

  # Strip any trailing dot
  prefix="${prefix%.}"

  # Count dots to determine prefix length
  local dot_count=$(echo "$prefix" | tr -cd '.' | wc -c)

  local target
  if (( dot_count == 1 )); then
    target="${prefix}.0.0/16"
  else
    target="${prefix}.0/24"
  fi

  echo "🔍 Sweeping ${target}..."

  local results
  results=$(nmap -sn -n -T4 --max-retries 1 "$target" 2>/dev/null \
    | grep 'Nmap scan report for' \
    | awk '{print $NF}' \
    | tr -d '()')

  if [[ -z "$results" ]]; then
    echo "❌ No hosts responded on ${target}"
    return 1
  fi

  echo "✅ Alive hosts:"
  printf '  %s\n' ${(f)results}
}

