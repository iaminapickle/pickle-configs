# The mirror image, for the WSL side of the same dual-boot box: reboot
# straight into CachyOS. Windows' equivalent of `efibootmgr --bootnext` is a
# one-shot firmware boot sequence set through bcdedit {fwbootmgr}.
#
# Reading *and* setting it need Administrator, so the work happens in an
# elevated PowerShell. The UAC prompt is the speed bump here that sudo is on
# the Linux side. The script is passed as -EncodedCommand (base64 UTF-16LE)
# rather than a temp file: no quoting to get wrong, and nothing to clean up.
#
# The entry is matched by description, not a hardcoded GUID, so it survives a
# bootloader reinstall. The default pattern covers the bootloaders CachyOS
# actually installs -- Limine is its current default, and the firmware entry
# is named after the bootloader, not the distro. Note "UEFI OS" is the generic
# \EFI\BOOT\BOOTX64.EFI fallback entry and is deliberately not matched.
#
# If the guess is wrong, pin it in ~/.zshrc.local:
#   REBOOT_TO_CACHY_ENTRY='Limine'
if [[ "$(uname -r)" == *[Mm]icrosoft* ]] && [[ -x /mnt/c/Windows/System32/bcdedit.exe ]]; then
    reboot-to-cachy() {
        local pattern="${REBOOT_TO_CACHY_ENTRY:-CachyOS|Limine|Linux Boot Manager|GRUB|systemd-boot}"
        local body enc
        body=$(cat <<'PS'
$ErrorActionPreference = 'Stop'

function Fail($msg) {
    Write-Host $msg -ForegroundColor Red
    Write-Host ''
    Write-Host 'Press any key to close...'
    $null = $Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown')
    exit 1
}

$raw = (& bcdedit /enum firmware) -join "`n"

$found = @()
foreach ($b in [regex]::Split($raw, '(?:\r?\n){2,}')) {
    $id = [regex]::Match($b, '(?m)^identifier\s+(\S+)')
    $ds = [regex]::Match($b, '(?m)^description\s+(.+?)\s*$')
    if ($id.Success -and $ds.Success) {
        $found += [pscustomobject]@{ Id = $id.Groups[1].Value; Desc = $ds.Groups[1].Value }
    }
}

$list = ($found | ForEach-Object { "  {0,-36} {1}" -f $_.Desc, $_.Id }) -join "`n"
$hits = @($found | Where-Object { $_.Desc -match $pattern })

if ($hits.Count -eq 0) {
    Fail "No firmware entry matched /$pattern/.`n`nEntries on this machine:`n$list`n`nSet REBOOT_TO_CACHY_ENTRY in ~/.zshrc.local to match one."
}
if ($hits.Count -gt 1) {
    Fail "Pattern /$pattern/ matched more than one entry:`n$list`n`nNarrow it with REBOOT_TO_CACHY_ENTRY in ~/.zshrc.local."
}

& bcdedit /set "{fwbootmgr}" bootsequence $hits[0].Id | Out-Null
if ($LASTEXITCODE -ne 0) { Fail "bcdedit failed to set bootsequence (exit $LASTEXITCODE)" }

Write-Host ("Next boot: {0}. Rebooting..." -f $hits[0].Desc) -ForegroundColor Magenta
Start-Sleep -Seconds 1
& shutdown /r /t 0
PS
)
        enc=$(printf '%s\n%s' "\$pattern = '$pattern'" "$body" \
              | iconv -f UTF-8 -t UTF-16LE | base64 -w0)
        powershell.exe -NoProfile -Command \
            "Start-Process powershell -Verb RunAs -ArgumentList '-NoProfile','-EncodedCommand','$enc'"
    }
fi

