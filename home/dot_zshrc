DaySuffix() {
  case `date +%e` in
    1|21|31) echo "st";;
    2|22)    echo "nd";;
    3|23)    echo "rd";;
    *)       echo "th";;
  esac
}
start_day_name=$(date +%A)
day_suffix=$(DaySuffix)
start_day=$(date '+%d')
start_month_year=$(date '+%B %Y')

