# Shared by the CachyOS box and WSL. Branches at runtime rather than being a
# chezmoi template, so the file stays plain and `chezmoi re-add` keeps working
# on it. Machine-specific settings belong in ~/.zshrc.local (untracked), which
# is sourced at the very bottom.

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ---------------------------------------------------------------------------
# Plugin framework
# ---------------------------------------------------------------------------
# CachyOS ships a curated zsh config; everywhere else (Ubuntu under WSL) use
# oh-my-zsh plus znap. Both end up on powerlevel10k, so everything below this
# block is identical either way.
if [[ -r /usr/share/cachyos-zsh-config/cachyos-config.zsh ]]; then
    source /usr/share/cachyos-zsh-config/cachyos-config.zsh
    unsetopt correct_all correct
else
    export ZSH="$HOME/.oh-my-zsh"
    ZSH_THEME="powerlevel10k/powerlevel10k"
    plugins=(git copypath direnv)
    [[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

    # znap: bootstrap on first run, then load the extras.
    [[ -r ~/zsh-plugins/znap/znap.zsh ]] ||
        git clone --depth 1 -- \
            https://github.com/marlonrichert/zsh-snap.git ~/zsh-plugins/znap
    source ~/zsh-plugins/znap/znap.zsh
    zstyle ':znap:*' repos-dir ~/zsh-plugins
    znap source fdellwing/zsh-bat
    znap source zsh-users/zsh-syntax-highlighting
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet

# fzf ships its shell integration two different ways depending on version.
if [ -f ~/.fzf.zsh ]; then
    source ~/.fzf.zsh
elif command -v fzf >/dev/null; then
    source <(fzf --zsh)
fi

eval "$(direnv hook zsh)"
export PATH="$HOME/.local/bin:$PATH"

# ---------------------------------------------------------------------------
# Clipboard
# ---------------------------------------------------------------------------
# Wayland on the CachyOS box, clip.exe under WSL (full path: PATH interop can
# be switched off), X11 as a fallback. Everything that copies goes through
# _clip so the rest of the file doesn't care.
if command -v wl-copy >/dev/null 2>&1; then
    _clip() { wl-copy }
elif [[ -x /mnt/c/Windows/System32/clip.exe ]]; then
    _clip() { /mnt/c/Windows/System32/clip.exe }
elif command -v xclip >/dev/null 2>&1; then
    _clip() { xclip -selection clipboard }
else
    _clip() { cat }
fi

# Pipe stdin to the clipboard, e.g. `cat file | toc`
toc() { printf '%s' "$(cat)" | _clip }

