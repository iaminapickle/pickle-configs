# Print the default branch of a remote (default: origin).
#
# refs/remotes/<remote>/HEAD is written at clone time, so the common case costs
# nothing. When it is missing -- a --single-branch or older clone -- ask the
# remote once; set-head caches the answer in the ref so the next call is local
# again. If the remote's default branch changes later the ref goes stale;
# `git remote set-head origin -a` refreshes it.
git-default-branch() {
    local remote ref
    remote=${1:-origin}

    if ! git remote get-url "$remote" >/dev/null 2>&1; then
        remote=$(git remote | head -1)
    fi
    [[ -n "$remote" ]] || return 1

    ref=$(git symbolic-ref --quiet "refs/remotes/$remote/HEAD" 2>/dev/null)
    if [[ -z "$ref" ]]; then
        git remote set-head "$remote" --auto >/dev/null 2>&1
        ref=$(git symbolic-ref --quiet "refs/remotes/$remote/HEAD" 2>/dev/null)
    fi
    [[ -n "$ref" ]] || return 1

    print -r -- "${ref#refs/remotes/$remote/}"
}

gitcom() {
    local branch
    if ! branch=$(git-default-branch "$@"); then
        echo "gitcom: could not determine the default branch" >&2
        return 1
    fi
    git checkout "$branch"
}

git-prune-branches() {
    local main_branch="${1:-$(git-default-branch)}"
    if [[ -z "$main_branch" ]]; then
        echo "git-prune-branches: could not determine the default branch" >&2
        return 1
    fi
    git fetch --prune

    local current_branch
    current_branch=$(git branch --show-current)

    for branch in $(git branch | sed 's/^\*//' | tr -d ' '); do
        # Skip the main branch itself
        [[ "$branch" == "$main_branch" ]] && continue

        local category=""

        if git rev-parse --abbrev-ref "$branch@{upstream}" &>/dev/null; then
            # Has a live upstream — leave it alone entirely
            continue
        fi

        # Check branch -vv output for "gone" marker
        if git branch -vv | grep "^\*\? *$branch " | grep -q ': gone]'; then
            category="Upstream Gone"
        else
            category="Local Only"
        fi

        echo "Branch '$branch' — $category"
        read "confirm?Delete '$branch'? [y/N] "
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            if [[ "$branch" == "$current_branch" ]]; then
                echo "Can't delete the branch you're currently on. Skipped."
            else
                git branch -D "$branch"
            fi
        else
            echo "Skipped $branch"
        fi
    done
}

