# ---------------------------------------------------------------------------
# Never managed, on any OS
# ---------------------------------------------------------------------------

# Regenerated by `caelestia scheme`; tracking them means a dirty worktree
# after every theme switch.
.config/gtk-3.0
.config/gtk-4.0
.config/qt5ct
.config/qt6ct
.config/qtengine
.config/kdeglobals
.config/btop/themes
.config/kitty/themes
.config/alacritty/themes
.config/nvtop/nvtop.colors
.config/htop/htoprc
.config/hypr/scheme/current.lua

# Managed by lazy.nvim. Drop this line to pin plugin versions across machines.
.local/share/nvim

# Runtime / cache state that happens to live under .config
.config/caelestia/monitors

# Zebar's ledger of the marketplace packs this machine has unpacked: one
# record per pack, holding the id and version whose content lives in the
# sibling <packId>@<version> directory. The packs themselves aren't tracked,
# so a restored ledger asserts installs that aren't there -- three of the four
# records here already name packs with no directory on disk.
.glzr/zebar/.marketplace

# Built from the tracked .cs by 40-glazewm-scripts.ps1, never committed.
.glzr/glazewm/scripts/*.exe

# GlazeWM/Zebar runtime droppings and the editor's own config backups.
.glzr/glazewm/errors.log
.glzr/zebar/errors.log
.glzr/glazewm/config.yaml.bak-*
.glzr/zebar/settings.json.bak-*

# ---------------------------------------------------------------------------
# Windows: ignore all, then un-ignore what is actually ready. nvim works here
# because 45-xdg-config-home.ps1 points XDG_CONFIG_HOME at ~/.config; zed is
# still the holdout.
# ---------------------------------------------------------------------------
{{ if eq .chezmoi.os "windows" }}
**
# `**` matches script targets too. Un-ignore them -- each template carries its
# own OS guard, and a guarded-out one renders empty, which chezmoi skips.
!.chezmoiscripts
!.chezmoiscripts/**
!.gitconfig
!.gitignore_global
!.config
!.config/git
!.config/git/**
!.ssh
!.ssh/**
!.glzr
!.glzr/**
!.config/wezterm
!.config/wezterm/**
!.config/nvim
!.config/nvim/**
# re-assert the build artifacts, which the .glzr un-ignore above would undo
.glzr/glazewm/scripts/*.exe
.glzr/glazewm/errors.log
.glzr/zebar/errors.log
.glzr/zebar/.marketplace
{{ end }}

# ---------------------------------------------------------------------------
# Linux: skip the Windows-only half
# ---------------------------------------------------------------------------
{{ if eq .chezmoi.os "linux" }}
Documents/PowerShell
AppData
.glzr
{{ end }}

# ---------------------------------------------------------------------------
# WSL: detected by the kernel string, not a prompt -- a machine does not stop
# being WSL. No desktop and a different shell setup, so ignore all and
# un-ignore only the git identity, keys, zshrc and nvim.
# ---------------------------------------------------------------------------
{{ if and (eq .chezmoi.os "linux") (contains "microsoft" (lower (default "" .chezmoi.kernel.osrelease))) }}
**
# `**` matches script targets too. Un-ignore them -- each template carries its
# own OS guard, and a guarded-out one renders empty, which chezmoi skips.
!.chezmoiscripts
!.chezmoiscripts/**
!.gitconfig
!.gitignore_global
!.config
!.config/git
!.config/git/**
!.ssh
!.ssh/**
!.zshrc
!.p10k.zsh
!.config/nvim
!.config/nvim/**
{{ end }}

# ---------------------------------------------------------------------------
# Profile-conditional
# ---------------------------------------------------------------------------
{{ if not .gaming }}
.config/MangoHud
.config/vkBasalt
{{ end }}
