# ---------------------------------------------------------------------------
# Never managed, on any OS
# ---------------------------------------------------------------------------

# Regenerated by `caelestia scheme` every time the colourscheme changes.
# Tracking these means a dirty worktree after every theme switch.
.config/gtk-3.0
.config/gtk-4.0
.config/qt5ct
.config/qt6ct
.config/qtengine
.config/kdeglobals
.config/btop/themes
.config/kitty/themes
.config/alacritty/themes
.config/nvtop/nvtop.colors
.config/htop/htoprc
.config/hypr/scheme/current.lua

# Plugin lockfile churn is managed by lazy.nvim itself, not by hand.
# (Delete this line if you'd rather pin plugin versions across machines.)
.local/share/nvim

# Runtime / cache state that happens to live under .config
.config/caelestia/monitors

# GlazeWM helpers are built from the tracked .cs by
# .chezmoiscripts/run_onchange_after_40-glazewm-scripts.ps1, never committed.
.glzr/glazewm/scripts/*.exe

# GlazeWM/Zebar runtime droppings and the editor's own config backups.
.glzr/glazewm/errors.log
.glzr/zebar/errors.log
.glzr/glazewm/config.yaml.bak-*
.glzr/zebar/settings.json.bak-*

# ---------------------------------------------------------------------------
# Windows: same narrow approach as WSL. The Windows half of this repo is not
# finished (see docs/windows.md) and several configs there are hand-adapted
# already -- wezterm.lua launches WSL rather than zsh, and nvim/zed would land
# at ~/.config paths that Windows apps don't read. So track only what is
# actually ready: the git identity, the SSH keys, and the GlazeWM/Zebar setup.
# Un-ignore more as docs/windows.md items get done.
# ---------------------------------------------------------------------------
{{ if eq .chezmoi.os "windows" }}
**
# The `**` above matches script targets too, which silently disables every
# .chezmoiscripts/ entry. Un-ignore them: each script template already carries
# its own OS guard, and a guarded-out template renders empty, which chezmoi
# skips -- so the routing stays in one place rather than being restated here.
!.chezmoiscripts
!.chezmoiscripts/**
!.gitconfig
!.gitignore_global
!.config
!.config/git
!.config/git/**
!.ssh
!.ssh/**
!.glzr
!.glzr/**
!.config/wezterm
!.config/wezterm/**
# re-assert the build artifacts, which the .glzr un-ignore above would undo
.glzr/glazewm/scripts/*.exe
.glzr/glazewm/errors.log
.glzr/zebar/errors.log

# focus-sync only matters with multiple monitors (see .chezmoi.toml.tmpl).
{{ if not .multiMonitor }}
.glzr/glazewm/scripts/focus-sync.cs
{{ end }}
{{ end }}

# ---------------------------------------------------------------------------
# Linux: skip the Windows-only half
# ---------------------------------------------------------------------------
{{ if eq .chezmoi.os "linux" }}
Documents/PowerShell
AppData
.glzr
{{ end }}

# ---------------------------------------------------------------------------
# WSL: Ubuntu under Windows, detected by the kernel string rather than a
# prompt -- a machine does not stop being WSL. It shares this repo for one
# reason only: the git identity split and the SSH keys. The shell here is
# oh-my-zsh + znap rather than p10k + cachyos-zsh-config, nvim has diverged,
# and there is no desktop at all, so everything else stays hand-maintained.
# Ignore all, then un-ignore the two things we do want.
# ---------------------------------------------------------------------------
{{ if and (eq .chezmoi.os "linux") (contains "microsoft" (lower (default "" .chezmoi.kernel.osrelease))) }}
**
# The `**` above matches script targets too, which silently disables every
# .chezmoiscripts/ entry. Un-ignore them: each script template already carries
# its own OS guard, and a guarded-out template renders empty, which chezmoi
# skips -- so the routing stays in one place rather than being restated here.
!.chezmoiscripts
!.chezmoiscripts/**
!.gitconfig
!.gitignore_global
!.config
!.config/git
!.config/git/**
!.ssh
!.ssh/**
!.zshrc
!.p10k.zsh
!.config/nvim
!.config/nvim/**
{{ end }}

# ---------------------------------------------------------------------------
# Profile-conditional
# ---------------------------------------------------------------------------
{{ if not .gaming }}
.config/MangoHud
.config/vkBasalt
{{ end }}
