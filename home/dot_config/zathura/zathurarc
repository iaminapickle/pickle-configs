# Mirrors the nvim keymaps in ~/.config/nvim/lua/config/keymaps.lua.
# The file is parsed with shell-style quoting, so ; ' and " are quoted.

# Mouse selections go to the system clipboard, like nvim's unnamedplus
set selection-clipboard clipboard

# Motion remap: k/l/;/' as left/down/up/right. ' replaces the default
# mark jump, as it does in nvim.
map k   scroll left
map l   scroll down
map ";" scroll up
map "'" scroll right

map [fullscreen] k   scroll left
map [fullscreen] l   scroll down
map [fullscreen] ";" scroll up
map [fullscreen] "'" scroll right

# Big jumps. nvim moves 10 lines here; half a screen is the closest match in a
# PDF. This takes K away from "previous page", but PageUp still does that.
map L   scroll half-down
map ":" scroll half-up

map [fullscreen] L   scroll half-down
map [fullscreen] ":" scroll half-up

# Enter opens the command line (frees up : for the jump above)
map <Return>   focus_inputbar ":"
map <S-Return> focus_inputbar ":"

map [fullscreen] <Return>   focus_inputbar ":"
map [fullscreen] <S-Return> focus_inputbar ":"

# Start/end of line -> scroll fully left/right
map K   scroll full-left
map '"' scroll full-right

map [fullscreen] K   scroll full-left
map [fullscreen] '"' scroll full-right

# Ctrl-R reloads from disk, as in nvim. Recolor moves to R, swapping the two
# defaults.
map <C-r> reload
map R     recolor

map [fullscreen] <C-r> reload
map [fullscreen] R     recolor

# Index (table of contents): same directions. k collapses and ' expands.
map [index] k   navigate_index collapse
map [index] l   navigate_index down
map [index] ";" navigate_index up
map [index] "'" navigate_index expand
