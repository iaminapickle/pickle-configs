# Mirrors the nvim keymaps in ~/.config/nvim/lua/config/keymaps.lua.
# Format is `command key`; anything here overrides sioyek's defaults.
# h stays sioyek's add_highlight (select text, then h + a letter).

# Motion remap: k/l/;/' as left/down/up/right. move_left/move_right name the
# direction the page moves, not the view, so they're crossed (sioyek's own
# defaults bind move_left to <right>). The visual_mark commands also drive the
# ruler, and fall back to a plain scroll when it's off.
move_right            k
move_visual_mark_down l
move_visual_mark_up   ;
move_left             '

# Big jumps. nvim moves 10 lines here; move_down is an inch per step, so half a
# screen (move_screen_ratio) is the closer match.
screen_down L
screen_up   :

# Enter opens the command palette (frees up : for the jump above)
command <return>
command <S-<return>>

# Start/end of line
goto_left_smart  K
goto_right_smart "

# Ctrl-R reloads from disk
reload <C-r>
