{{- if eq .chezmoi.os "windows" -}}
# nvim-treesitter's main branch needs the tree-sitter CLI, which winget has no
# package for -- so fetch the release binary, like 36-tree-sitter-cli.sh does
# for WSL. zig, from packages.yaml, is the compiler the CLI drives.

$ErrorActionPreference = 'Stop'

function Log($msg) { Write-Host ":: $msg" -ForegroundColor Magenta }

# Pinned, and the hash is of the extracted .exe so the check below can reuse it.
$Version = 'v0.27.0'
$Sha256  = '9FBC4F285C876B1A38C7E9D5223A51FB7842255285CDD7DB3FFB0BA3934F2662'
$Url     = "https://github.com/tree-sitter/tree-sitter/releases/download/$Version/tree-sitter-cli-windows-x64.zip"

# Same ~/bin as win32yank, but this one has to be on PATH: nvim spawns
# `tree-sitter` by name.
$binDir = Join-Path $env:USERPROFILE 'bin'
$target = Join-Path $binDir 'tree-sitter.exe'

# Coalesced to '' -- an empty user PATH returns $null, and .TrimEnd() on that throws.
$userPath = [Environment]::GetEnvironmentVariable('PATH', 'User')
if (-not $userPath) { $userPath = '' }
if (($userPath -split ';') -notcontains $binDir) {
    $newPath = ($userPath.TrimEnd(';') + ";$binDir").TrimStart(';')
    [Environment]::SetEnvironmentVariable('PATH', $newPath, 'User')
    Log "added $binDir to the user PATH (takes effect in new processes)"
}
# ...and for the rest of this session, so a checksum retry can find it.
if (($env:PATH -split ';') -notcontains $binDir) { $env:PATH = "$env:PATH;$binDir" }

if ((Test-Path $target) -and (Get-FileHash $target -Algorithm SHA256).Hash -eq $Sha256) {
    Log "tree-sitter $Version already present at $target"
    return
}

Log "installing tree-sitter $Version -> $target"

$tmp = Join-Path ([System.IO.Path]::GetTempPath()) ([System.IO.Path]::GetRandomFileName())
New-Item -ItemType Directory -Path $tmp | Out-Null
try {
    $zip = Join-Path $tmp 'tree-sitter.zip'

    # 5.1 does not always negotiate TLS 1.2, and GitHub refuses anything older.
    [Net.ServicePointManager]::SecurityProtocol =
        [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12

    # The progress bar makes a multi-MB download crawl on 5.1.
    $prevProgress = $ProgressPreference
    $ProgressPreference = 'SilentlyContinue'
    try {
        Invoke-WebRequest -Uri $Url -OutFile $zip -UseBasicParsing
    } finally {
        $ProgressPreference = $prevProgress
    }

    # Expand-Archive ships with 5.1, so there is no unzip to install first.
    Expand-Archive -Path $zip -DestinationPath $tmp -Force

    $exe = Join-Path $tmp 'tree-sitter.exe'
    if (-not (Test-Path $exe)) {
        throw "tree-sitter.exe not found inside the release zip"
    }

    $got = (Get-FileHash $exe -Algorithm SHA256).Hash
    if ($got -ne $Sha256) {
        Write-Warning "checksum mismatch for tree-sitter $Version"
        Write-Warning "  expected $Sha256"
        Write-Warning "  got      $got"
        throw "refusing to install; update the hash in this script if the release changed"
    }

    New-Item -ItemType Directory -Path $binDir -Force | Out-Null
    Copy-Item $exe $target -Force
} finally {
    Remove-Item $tmp -Recurse -Force -ErrorAction SilentlyContinue
}

Log "tree-sitter ready"
{{- end -}}
