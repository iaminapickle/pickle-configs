{{- if eq .chezmoi.os "windows" -}}
# Point XDG_CONFIG_HOME at %USERPROFILE%\.config so Windows nvim reads
# .config/nvim rather than %LOCALAPPDATA%\nvim. User scope, so no elevation;
# only new processes see it. run_after_ to re-assert on every apply.

$ErrorActionPreference = 'Stop'

function Log($msg) { Write-Host ":: $msg" -ForegroundColor Magenta }

$want = Join-Path $env:USERPROFILE '.config'
$have = [Environment]::GetEnvironmentVariable('XDG_CONFIG_HOME', 'User')

if ($have -eq $want) {
    Log "XDG_CONFIG_HOME already $want"
} else {
    if ($have) { Log "XDG_CONFIG_HOME was '$have' -- repointing" }
    [Environment]::SetEnvironmentVariable('XDG_CONFIG_HOME', $want, 'User')
    $env:XDG_CONFIG_HOME = $want
    Log "XDG_CONFIG_HOME -> $want (takes effect in new processes)"
}
{{- end -}}
