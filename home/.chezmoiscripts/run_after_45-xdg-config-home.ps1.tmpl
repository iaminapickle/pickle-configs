{{- if eq .chezmoi.os "windows" -}}
# Point XDG_CONFIG_HOME at %USERPROFILE%\.config.
#
# Neovim on Windows reads %LOCALAPPDATA%\nvim unless XDG_CONFIG_HOME is set,
# so without this the .config/nvim entries land in a directory nvim never
# looks in -- which is why the Windows half of .chezmoiignore used to skip
# nvim altogether. With it set, all three machines share one lua/ tree.
#
# Consistent with what the box already does: .config/git and .config/wezterm
# deploy under ~/.config here too, because git and wezterm look there on
# Windows natively. This just extends that to the tools that don't.
#
# User scope rather than Machine: no elevation needed, and it survives
# reboots. Note it only reaches processes started afterwards -- an already
# open terminal keeps the old value until restarted.
#
# run_after_ rather than run_onchange_, matching 50-ssh-acl.ps1: this script
# has no dynamic content, so run_onchange_ would fire once and never verify
# again. A registry read per apply is a few milliseconds and always correct.

$ErrorActionPreference = 'Stop'

function Log($msg) { Write-Host ":: $msg" -ForegroundColor Magenta }

$want = Join-Path $env:USERPROFILE '.config'
$have = [Environment]::GetEnvironmentVariable('XDG_CONFIG_HOME', 'User')

if ($have -eq $want) {
    Log "XDG_CONFIG_HOME already $want"
} else {
    if ($have) { Log "XDG_CONFIG_HOME was '$have' -- repointing" }
    [Environment]::SetEnvironmentVariable('XDG_CONFIG_HOME', $want, 'User')
    $env:XDG_CONFIG_HOME = $want
    Log "XDG_CONFIG_HOME -> $want (takes effect in new processes)"
}
{{- end -}}
