{{- if eq .chezmoi.os "windows" -}}
# Package bootstrap, Windows half. Mirrors 10-packages.sh.tmpl: winget is the
# primary, chocolatey only if packages.windows.choco is non-empty.
# Written for PowerShell 5.1, which is what chezmoi invokes .ps1 with.

$ErrorActionPreference = 'Stop'

function Log($msg)  { Write-Host ":: $msg" -ForegroundColor Magenta }
function Warn($msg) { Write-Host "-- $msg" -ForegroundColor Yellow }

# --- winget ----------------------------------------------------------------
if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    throw "winget not found. Install 'App Installer' from the Microsoft Store first."
}

# Portable packages install as symlinks in WinGet\Links, which a non-admin can
# only create with Developer Mode on -- without it winget still exits 0 and the
# binaries are unreachable. Warn, don't throw: anything with a real installer
# lands in Program Files regardless.
$devMode = (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock' `
    -Name AllowDevelopmentWithoutDevLicense -ErrorAction SilentlyContinue).AllowDevelopmentWithoutDevLicense
if ($devMode -ne 1) {
    Warn "Developer Mode is off (Settings -> System -> For developers)."
    Warn "winget cannot create its Links symlinks without it, so portable"
    Warn "packages install but never reach PATH. Enable it, then re-run the"
    Warn "affected installs with --force to create the links."
}

$WingetPkgs = @(
{{- range $group, $pkgs := .packages.windows.winget }}
    # {{ $group }}
{{- range $pkgs }}
    '{{ . }}'
{{- end }}
{{- end }}
)

Log "syncing winget packages ($($WingetPkgs.Count))"

foreach ($id in $WingetPkgs) {
    # Check first to stay quiet and skip a re-download. --source winget avoids
    # the msstore ambiguity prompt, which would hang an unattended run.
    winget list --id $id --exact --source winget *> $null
    if ($LASTEXITCODE -eq 0) { continue }

    Log "installing $id"
    winget install --id $id --exact --source winget --silent `
        --accept-package-agreements --accept-source-agreements `
        --disable-interactivity

    # 0x8A150061 is "already installed" -- benign, still reachable via another source.
    if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -ne -1978335135) {
        Warn "winget install $id failed (exit $LASTEXITCODE) -- continuing"
    }
}

{{ if .packages.windows.choco }}
# --- chocolatey (fallback only) --------------------------------------------
# Only reached when packages.windows.choco is non-empty. Needs an elevated shell.
$ChocoPkgs = @(
{{- range $group, $pkgs := .packages.windows.choco }}
    # {{ $group }}
{{- range $pkgs }}
    '{{ . }}'
{{- end }}
{{- end }}
)

if (-not (Get-Command choco -ErrorAction SilentlyContinue)) {
    $admin = ([Security.Principal.WindowsPrincipal] `
        [Security.Principal.WindowsIdentity]::GetCurrent()
    ).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    if (-not $admin) {
        throw "chocolatey packages are listed but choco is not installed, and installing it needs an elevated shell. Re-run 'chezmoi apply' as administrator."
    }
    Log "bootstrapping chocolatey"
    Set-ExecutionPolicy Bypass -Scope Process -Force
    [System.Net.ServicePointManager]::SecurityProtocol = `
        [System.Net.ServicePointManager]::SecurityProtocol -bor 3072
    Invoke-Expression ((New-Object System.Net.WebClient).DownloadString(
        'https://community.chocolatey.org/install.ps1'))
    $env:Path = [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' +
                [Environment]::GetEnvironmentVariable('Path', 'User')
}

Log "syncing choco packages ($($ChocoPkgs.Count))"
choco install @ChocoPkgs --yes --limit-output --no-progress
if ($LASTEXITCODE -ne 0) { Warn "choco install returned $LASTEXITCODE" }
{{ end }}
Log "packages done"
{{- end -}}
