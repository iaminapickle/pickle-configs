{{- /* Arch/CachyOS only. Quickshell loads a config directory whole, with no
       per-file overlay, so rebuild a full user copy of caelestia-shell's QML
       from the installed package and apply our patch on top. Reruns when
       either changes, so the fork does not go stale. */ -}}
{{- if and (eq .chezmoi.os "linux") (not (contains "microsoft" (lower (default "" .chezmoi.kernel.osrelease)))) -}}
#!/usr/bin/env bash
# caelestia-shell: {{ output "sh" "-c" "pacman -Q caelestia-shell 2>/dev/null || true" | trim }}
# overrides: {{ include "dot_config/caelestia/shell-overrides/modules/session/Content.qml" | sha256sum }} {{ include "dot_config/caelestia/shell-overrides/modules/drawers/Interactions.qml" | sha256sum }} {{ include "dot_config/caelestia/shell-overrides/modules/osd/Content.qml" | sha256sum }} {{ include "dot_config/caelestia/shell-overrides/modules/bar/components/OsIcon.qml" | sha256sum }}
set -euo pipefail

log() { printf '\033[1;35m::\033[0m %s\n' "$*"; }

SRC=/etc/xdg/quickshell/caelestia
DEST="$HOME/.config/quickshell/caelestia"
OVERRIDES="$HOME/.config/caelestia/shell-overrides"

if [ ! -d "$SRC" ] || [ ! -d "$OVERRIDES" ]; then
    exit 0
fi

log "rebuilding caelestia-shell override at $DEST"
rm -rf "$DEST"
mkdir -p "$(dirname "$DEST")"
cp -r "$SRC" "$DEST"
cp -r "$OVERRIDES"/. "$DEST"/

log "restart the caelestia shell (pkill -x qs && caelestia shell -d) to pick up changes"
{{- end -}}
