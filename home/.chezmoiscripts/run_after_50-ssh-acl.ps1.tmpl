{{- if eq .chezmoi.os "windows" -}}
# Lock down the SSH keys and age identity with Windows ACLs: `private_`'s mode
# 0600 means nothing here, and OpenSSH refuses a key others can read. Files
# under the profile inherit its ACL, so inheritance has to be broken.
# run_after_ because a re-created file picks that inherited ACL back up.

$ErrorActionPreference = 'Stop'

function Log($msg) { Write-Host ":: $msg" -ForegroundColor Magenta }

# By SID, not name -- account and group names are localized.
$sid = ([Security.Principal.WindowsIdentity]::GetCurrent()).User.Value

$targets = @(
    (Join-Path $env:USERPROFILE '.ssh\personal'),
    (Join-Path $env:USERPROFILE '.ssh\work_github'),
    (Join-Path $env:USERPROFILE '.ssh\work_bitbucket'),
    (Join-Path $env:USERPROFILE '.config\chezmoi\key.txt')
)

# icacls is idempotent, so just assert rather than detect.
foreach ($path in $targets) {
    if (-not (Test-Path $path)) { continue }

    # /inheritance:r drops inherited ACEs, /grant:r replaces, * marks a SID.
    & icacls $path /inheritance:r /grant:r "*${sid}:(F)" *> $null
    if ($LASTEXITCODE -ne 0) {
        Write-Warning "icacls failed on $path (exit $LASTEXITCODE)"
    }
}

# The .ssh dir itself: a writable-by-others .ssh lets someone swap config out.
$sshDir = Join-Path $env:USERPROFILE '.ssh'
if (Test-Path $sshDir) {
    & icacls $sshDir /inheritance:r /grant:r "*${sid}:(OI)(CI)(F)" *> $null
}

Log "ssh key ACLs asserted"
{{- end -}}
