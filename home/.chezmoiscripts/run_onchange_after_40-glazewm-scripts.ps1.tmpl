{{- if eq .chezmoi.os "windows" -}}
# Build the GlazeWM helpers from the tracked .cs in ~/.glzr/glazewm/scripts;
# the .exe are build artifacts and stay out of git. Both target .NET Framework
# 4.x, whose csc.exe ships with Windows, so there is no toolchain to install.
# The digests below are what trigger a rebuild:
#   workspace-nav.cs {{ include "dot_glzr/glazewm/scripts/workspace-nav.cs" | sha256sum }}
#   focus-sync.cs    {{ include "dot_glzr/glazewm/scripts/focus-sync.cs" | sha256sum }}
#   focus-dir.cs     {{ include "dot_glzr/glazewm/scripts/focus-dir.cs" | sha256sum }}
#   wm-refresh.cs    {{ include "dot_glzr/glazewm/scripts/wm-refresh.cs" | sha256sum }}
#   wm-watch.cs      {{ include "dot_glzr/glazewm/scripts/wm-watch.cs" | sha256sum }}

$ErrorActionPreference = 'Stop'

function Log($msg) { Write-Host ":: $msg" -ForegroundColor Magenta }

$scripts = Join-Path $env:USERPROFILE '.glzr\glazewm\scripts'

$csc = Get-ChildItem 'C:\Windows\Microsoft.NET\Framework64\v4.*\csc.exe' -ErrorAction SilentlyContinue |
       Sort-Object FullName |
       Select-Object -Last 1
if (-not $csc) {
    Write-Warning "no .NET Framework 4.x csc.exe found -- skipping GlazeWM helper build."
    Write-Warning "the helpers will be missing, so the lwin+N workspace bindings, the"
    Write-Warning "empty-monitor focus fix and the automatic dock/undock restart won't"
    Write-Warning "work until they are built."
    return
}

# focus-sync runs persistently, so its .exe is locked while GlazeWM is up;
# capture whether it was up so we can bring it back after rebuilding. wm-watch
# is retired -- dock/undock is manual now -- so stop any stray instance to
# unlock its binary and stop it auto-restarting, but never bring it back.
$focusSyncRunning = [bool](Get-Process focus-sync -ErrorAction SilentlyContinue)
$stopped = $false
foreach ($name in 'focus-sync', 'wm-watch') {
    if (Get-Process $name -ErrorAction SilentlyContinue) {
        Log "stopping $name to unlock its binary"
        Stop-Process -Name $name -Force -ErrorAction SilentlyContinue
        $stopped = $true
    }
}
if ($stopped) { Start-Sleep -Milliseconds 300 }

# -target:winexe: a console binary would flash a window on every keypress.
# workspace-nav parses GlazeWM's IPC JSON by hand instead of pulling in
# System.Web.Extensions (JavaScriptSerializer), and is built x86 + ngen'd
# below, because it is spawned on every workspace keypress. focus-sync and
# focus-dir still use JavaScriptSerializer, hence their ref.
$builds = @(
    @{ Name = 'workspace-nav'; Refs = @(); Platform = 'x86'; Ngen = $true }
    ,@{ Name = 'focus-sync'; Refs = @('System.Web.Extensions.dll') }
    ,@{ Name = 'focus-dir'; Refs = @('System.Web.Extensions.dll') }
    ,@{ Name = 'wm-refresh'; Refs = @() }
    ,@{ Name = 'wm-watch'; Refs = @() }
)

foreach ($b in $builds) {
    $src = Join-Path $scripts "$($b.Name).cs"
    $out = Join-Path $scripts "$($b.Name).exe"
    if (-not (Test-Path $src)) {
        Write-Warning "missing source: $src -- skipped"
        continue
    }

    $cscArgs = @('-nologo', '-optimize+', '-target:winexe', "-out:$out")
    if ($b.Platform) { $cscArgs += "-platform:$($b.Platform)" }
    $cscArgs += $b.Refs | ForEach-Object { "-reference:$_" }
    $cscArgs += $src

    Log "building $($b.Name).exe"
    & $csc.FullName @cscArgs
    if ($LASTEXITCODE -ne 0) { throw "csc failed for $src (exit $LASTEXITCODE)" }

    # Precompile to a native image so the exe skips JIT at startup. Rebuilding
    # invalidates any prior image, so this runs after every build. ngen needs
    # an elevated apply; it's best-effort, so an unelevated apply still leaves a
    # working (JITed) exe. 32-bit ngen to match the x86 build above.
    if ($b.Ngen) {
        $ngen = Get-ChildItem 'C:\Windows\Microsoft.NET\Framework\v4.*\ngen.exe' -ErrorAction SilentlyContinue |
                Sort-Object FullName | Select-Object -Last 1
        if ($ngen) {
            Log "ngen $($b.Name).exe"
            & $ngen.FullName install $out 2>$null | Out-Null
            if ($LASTEXITCODE -ne 0) {
                Write-Warning "ngen failed for $($b.Name).exe (run 'chezmoi apply' elevated to precompile it); using the JITed exe."
            }
        }
    }
}

# Reloading the config doesn't re-run startup_commands, so bring focus-sync
# back if it was up. wm-watch is intentionally not restarted.
if ($focusSyncRunning) {
    Log "restarting focus-sync"
    Start-Process (Join-Path $scripts 'focus-sync.exe')
}

Log "GlazeWM helpers built"
{{- end -}}
