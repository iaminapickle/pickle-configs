{{- /* WSL only. nvim-treesitter's main branch shells out to the tree-sitter
       CLI for `tree-sitter build` -- see dot_config/nvim/lua/plugins/treesitter.lua,
       which installs 13 parsers. Without the CLI every one of them fails with
       ENOENT: no such file or directory (cmd): 'tree-sitter'.

       The CachyOS box gets this from pacman (tree-sitter-cli in
       .chezmoidata/packages.yaml) and Windows from 46-tree-sitter-cli.ps1.
       The WSL side has no package management at all, so fetch the release
       binary directly, the same way 35-wsl-win32yank.sh does.

       run_onchange rather than run_once so bumping VERSION/SHA256 below
       re-runs this. */ -}}
{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (lower (default "" .chezmoi.kernel.osrelease))) -}}
#!/usr/bin/env bash
set -euo pipefail

# Pinned rather than tracking /releases/latest/download so a fresh box always
# gets the build this SHA256 was verified against. The hash is of the
# *extracted* binary, not the .gz, so the already-installed check can reuse
# it. Verified against the official release asset.
VERSION=v0.27.0
SHA256=5a228811cdb3a01b7e4dd493c5fc5e05b0040a49ffede94e866c4c58ff2605db
URL="https://github.com/tree-sitter/tree-sitter/releases/download/${VERSION}/tree-sitter-linux-x64.gz"

log() { printf '\033[1;35m::\033[0m %s\n' "$*"; }

# A native Linux ELF, unlike win32yank -- nothing here crosses the filesystem
# bridge, so it lives on ext4. .zshrc already puts ~/.local/bin on $PATH.
TARGET="$HOME/.local/bin/tree-sitter"

if [ -f "$TARGET" ] && [ "$(sha256sum "$TARGET" | cut -d' ' -f1)" = "$SHA256" ]; then
    log "tree-sitter $VERSION already present at $TARGET"
    exit 0
fi

for t in curl gzip sha256sum; do
    if ! command -v "$t" >/dev/null; then
        log "$t not installed -- skipping tree-sitter"
        exit 0
    fi
done

log "installing tree-sitter $VERSION -> $TARGET"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# The .gz asset rather than the .zip on purpose: gzip is always present, and
# unzip is not -- that is exactly what 35-wsl-win32yank.sh had to work around.
curl -fsSL "$URL" -o "$tmp/ts.gz"
gzip -d "$tmp/ts.gz"

got="$(sha256sum "$tmp/ts" | cut -d' ' -f1)"
if [ "$got" != "$SHA256" ]; then
    log "checksum mismatch for tree-sitter $VERSION"
    log "  expected $SHA256"
    log "  got      $got"
    log "refusing to install; update SHA256 in this script if the release changed"
    exit 1
fi

mkdir -p "$(dirname "$TARGET")"
install -m 0755 "$tmp/ts" "$TARGET"

log "tree-sitter ready"
{{- end -}}
