{{- /* WSL only. nvim-treesitter needs the tree-sitter CLI, which pacman
       provides on CachyOS -- but the WSL side has no package management, so
       fetch the release binary the way 35-wsl-win32yank.sh does. */ -}}
{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (lower (default "" .chezmoi.kernel.osrelease))) -}}
#!/usr/bin/env bash
set -euo pipefail

# Pinned, and the hash is of the extracted binary so the check below reuses it.
VERSION=v0.27.0
SHA256=5a228811cdb3a01b7e4dd493c5fc5e05b0040a49ffede94e866c4c58ff2605db
URL="https://github.com/tree-sitter/tree-sitter/releases/download/${VERSION}/tree-sitter-linux-x64.gz"

log() { printf '\033[1;35m::\033[0m %s\n' "$*"; }

# A native ELF, unlike win32yank, so it lives on ext4. .zshrc has ~/.local/bin on $PATH.
TARGET="$HOME/.local/bin/tree-sitter"

if [ -f "$TARGET" ] && [ "$(sha256sum "$TARGET" | cut -d' ' -f1)" = "$SHA256" ]; then
    log "tree-sitter $VERSION already present at $TARGET"
    exit 0
fi

for t in curl gzip sha256sum; do
    if ! command -v "$t" >/dev/null; then
        log "$t not installed -- skipping tree-sitter"
        exit 0
    fi
done

log "installing tree-sitter $VERSION -> $TARGET"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# .gz not .zip: gzip is always present, unzip is not.
curl -fsSL "$URL" -o "$tmp/ts.gz"
gzip -d "$tmp/ts.gz"

got="$(sha256sum "$tmp/ts" | cut -d' ' -f1)"
if [ "$got" != "$SHA256" ]; then
    log "checksum mismatch for tree-sitter $VERSION"
    log "  expected $SHA256"
    log "  got      $got"
    log "refusing to install; update SHA256 in this script if the release changed"
    exit 1
fi

mkdir -p "$(dirname "$TARGET")"
install -m 0755 "$tmp/ts" "$TARGET"

log "tree-sitter ready"
{{- end -}}
