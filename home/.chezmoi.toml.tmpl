{{/* Interactive on first `chezmoi init`; answers cached in ~/.config/chezmoi/chezmoi.toml */}}
{{- $name    := promptStringOnce . "name"    "Git author name (personal)" -}}
{{- $email   := promptStringOnce . "email"   "Git author email (personal)" -}}
{{- $gaming  := promptBoolOnce   . "gaming"  "Install the gaming stack" -}}

{{/* GlazeWM only. One monitor skips focus-sync.exe and drops              */}}
{{/* workspace-nav.exe's per-monitor routing, which is a no-op there.       */}}
{{- $multiMonitor := false -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $multiMonitor = promptBoolOnce . "multiMonitor" "Multiple monitors on this machine" -}}
{{- end -}}

{{/* Second git identity, for repos under the work directory. Leave         */}}
{{/* workEmail blank and the include block drops out of .gitconfig.          */}}
{{- $workName  := promptStringOnce . "workName"  "Work git author name (blank for none)" "" -}}
{{- $workEmail := promptStringOnce . "workEmail" "Work git author email (blank for none)" "" -}}
{{- $workDir   := promptStringOnce . "workDir"   "Work repo directory, relative to ~" "Code/work" -}}

{{/* Public age recipient -- safe to commit, it can only encrypt. Lives      */}}
{{/* here rather than .chezmoidata/ because that loads after this file.       */}}
{{- $recipient := "age1twwfehzeqw5967qf0vvpw8alnmmq0wnyhd4pr2lu7hek9aq6he4s7nvlyg" -}}

encryption = {{ if ne $recipient "UNSET" }}"age"{{ else }}""{{ end }}

{{/* `chezmoi init --source X` does not persist X, so pin it here.           */}}
sourceDir   = {{ .chezmoi.workingTree | quote }}
workingTree = {{ .chezmoi.workingTree | quote }}

[data]
    name    = {{ $name | quote }}
    email   = {{ $email | quote }}
    gaming  = {{ $gaming }}
    multiMonitor = {{ $multiMonitor }}
    workName  = {{ $workName  | quote }}
    workEmail = {{ $workEmail | quote }}
    workDir   = {{ $workDir   | quote }}

{{ if ne $recipient "UNSET" -}}
[age]
    identity  = {{ (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt") | quote }}
    recipient = {{ $recipient | quote }}
{{ end -}}

{{/* delta as the pager, not diff.command: chezmoi passes an external       */}}
{{/* diff command "NUL:" for entries missing on disk, and Git for Windows   */}}
{{/* (which delta shells out to) cannot open that path. Excluding           */}}
{{/* "always" drops run_after_ scripts, which diff as pending forever.      */}}
[diff]
    pager     = "delta"
    pagerArgs = ["--paging", "never"]
    exclude   = ["always"]

[merge]
    command = "nvim"
    args    = ["-d", "{{ "{{ .Destination }}" }}", "{{ "{{ .Source }}" }}", "{{ "{{ .Target }}" }}"]

[git]
    autoCommit = false
    autoPush   = false

{{ if eq .chezmoi.os "windows" -}}
{{/* Windows defaults to a Restricted execution policy, which blocks the     */}}
{{/* .ps1 files chezmoi runs from %TEMP%. -File must stay last.              */}}
[interpreters.ps1]
    command = "powershell"
    args    = ["-NoLogo", "-ExecutionPolicy", "Bypass", "-File"]
{{ end -}}
